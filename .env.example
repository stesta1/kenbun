# Copiar a .env y ajustar. Todas las variables usan el prefijo MU_ (ver common/config.py).
# Los valores activos son la configuración con la que se probó el sistema; los comentados son
# los defaults ya definidos en config.py y solo hace falta descomentarlos para cambiarlos.

# --- Base de datos y storage ---
# Postgres y MinIO locales vía docker compose up -d postgres minio. Los
# defaults ya coinciden con docker-compose.yml, no hace falta descomentar.
# MU_DATABASE_URL=postgresql://monitoreo:monitoreo@localhost:5432/monitoreo_urbano
# MU_S3_ENDPOINT_URL=localhost:9000
# MU_S3_ACCESS_KEY=monitoreo
# MU_S3_SECRET_KEY=monitoreo123
# MU_S3_BUCKET_CLIPS=clips
# MU_S3_SECURE=false

# --- Módulo 1: vision_pipeline ---
# baseline_v6: yolo11s a 960 px (v5 + justjuu + FASDD_CV). Los demás pesos están en data/models/yolo.
MU_YOLO_WEIGHTS_PATH=data/models/yolo/baseline_v6.pt
MU_YOLO_DEVICE=cuda:0
MU_YOLO_CONFIDENCE_THRESHOLD=0.35
MU_YOLO_IMGSZ=960
# MU_TRACK_BUFFER_SECONDS=3.0
# MU_EVENT_DEDUP_RADIUS_PX=250.0
# MU_EVENT_DEDUP_WINDOW_SECONDS=90.0
# MU_CAMERA_BLANK_STD_THRESHOLD=6.0
# MU_CAMERA_HEALTH_SUSTAINED_SECONDS=5.0
# MU_CAMERA_SIGNAL_LOSS_SUSTAINED_SECONDS=9.0

# --- Módulo 2: vlm_describer ---
# Se descarga de HuggingFace la primera vez que arranca el módulo.
MU_VLM_BACKEND=qwen2-vl
MU_VLM_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct
MU_VLM_DEVICE=cuda:0

# --- Módulo 3a: event_store ---
# MU_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
# MU_EMBEDDING_DEVICE=cuda:0

# --- Módulo 3b: query_service ---
# Ollama corriendo local, endpoint compatible con OpenAI. Antes de arrancar: ollama pull qwen2.5:7b
MU_LLM_SERVER_BASE_URL=http://127.0.0.1:11434/v1
MU_LLM_MODEL_NAME=qwen2.5:7b
# MU_API_PORT=8000

# La API tiene que ser alcanzable desde el contenedor de MediaMTX para validar el video.
MU_API_HOST=0.0.0.0

# --- Acceso (RNF5) ---
# Correr `python scripts/generate_secrets.py`: completa MU_API_KEY (clave compartida de la API y
# MediaMTX) y las variables de MediaMTX, y las escribe en .env. Con MU_API_KEY vacía la API queda
# sin autenticación, solo para desarrollo local.
# MU_API_KEY=
# MTX_AUTHMETHOD=http
# MTX_AUTHHTTPADDRESS=http://host.docker.internal:8000/auth/mediamtx
